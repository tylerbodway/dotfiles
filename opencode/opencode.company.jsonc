{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "planning-center": {
      "name": "Planning Center / Anthropic",
      "package": "@opencode/ai/providers/anthropic",
      "models": {
        "claude-opus": {
          "modelID": "claude-opus-5-5",
          "name": "Claude Opus 5.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.2,
            "cache_write": 5,
          },
        },
        "claude-sonnet": {
          "modelID": "claude-sonnet-5-5",
          "name": "Claude Sonnet 5.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.2,
            "cache_write": 2.5,
          },
        },
        "claude-haiku": {
          "modelID": "claude-haiku-5-5",
          "name": "Claude Haiku 5.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 128000,
          },
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cache_read": 0.01,
            "cache_write": 0.125,
          },
        },
      },
    },
  },
  "model": "planning-center/claude-opus",
  "agents": {
    "general": {
      "model": "planning-center/claude-sonnet#high",
    },
    "explore": {
      "model": "planning-center/claude-sonnet#low",
    },
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Code/*",
      "effect": "allow",
    },
    { "action": "shell", "resource": "box *", "effect": "ask" },
    { "action": "shell", "resource": "box uninstall *", "effect": "deny" },
    { "action": "shell", "resource": "pco *", "effect": "ask" },
    { "action": "shell", "resource": "pco connect *", "effect": "deny" },
    { "action": "shell", "resource": "pco console *", "effect": "deny" },
    { "action": "shell", "resource": "pco dbconnect *", "effect": "deny" },
    { "action": "shell", "resource": "pco ssm *", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp",
        "disabled": true,
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": true,
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true,
      },
      "redshift": {
        "type": "local",
        "command": [
          "uv",
          "--directory",
          "{env:HOME}/Code/mcp-servers/redshift",
          "run",
          "awslabs.redshift-mcp-server",
        ],
        "environment": {
          "AWS_PROFILE": "pco-bi-query",
          "AWS_REGION": "us-east-1",
          "FASTMCP_LOG_LEVEL": "WARNING",
        },
        "disabled": true,
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "disabled": true,
      },
    },
  },
  "skills": ["~/Code/pco-box/skills"],
}
