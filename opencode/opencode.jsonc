{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash",
  "permissions": [
    // global rules
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },

    // potentially destructive or dangerous actions
    { "action": "shell", "resource": "brew *", "effect": "ask" },
    { "action": "shell", "resource": "bunx *", "effect": "deny" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "nc *", "effect": "deny" },
    { "action": "shell", "resource": "netcat *", "effect": "deny" },
    { "action": "shell", "resource": "npm *", "effect": "ask" },
    { "action": "shell", "resource": "npx *", "effect": "deny" },
    { "action": "shell", "resource": "pnpx *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "scp *", "effect": "deny" },
    { "action": "shell", "resource": "sftp *", "effect": "deny" },
    { "action": "shell", "resource": "ssh *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "yarn *", "effect": "ask" },
    { "action": "shell", "resource": "yarn dlx *", "effect": "deny" },
    { "action": "shell", "resource": "yarn lint *", "effect": "allow" },
    { "action": "shell", "resource": "yarn test *", "effect": "allow" },

    // secrets
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "edit", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "edit", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": ".env.local", "effect": "deny" },
    { "action": "edit", "resource": ".env.local", "effect": "deny" },
    { "action": "read", "resource": "secrets/**", "effect": "deny" },
    { "action": "edit", "resource": "secrets/**", "effect": "deny" },
    { "action": "read", "resource": ".secrets/**", "effect": "deny" },
    { "action": "edit", "resource": ".secrets/**", "effect": "deny" },
    { "action": "read", "resource": "credentials*", "effect": "deny" },
    { "action": "edit", "resource": "credentials*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*_rsa", "effect": "deny" },
    { "action": "read", "resource": "*_dsa", "effect": "deny" },
    { "action": "read", "resource": "*_ecdsa", "effect": "deny" },
    { "action": "read", "resource": "*_ed25519", "effect": "deny" },
    { "action": "read", "resource": ".ssh/**", "effect": "deny" },

    // agent config and artifacts
    {
      "action": "external_directory",
      "resource": "*/var/folders/*/T/**",
      "effect": "allow",
    },
    { "action": "edit", "resource": "*/var/folders/*/T/**", "effect": "allow" },
    { "action": "edit", "resource": "opencode/*", "effect": "allow" },
    { "action": "edit", "resource": ".opencode/**", "effect": "allow" },
    { "action": "edit", "resource": ".docs/**", "effect": "allow" },
  ],
  "agents": {
    "build": { "color": "#f3be7c" },
    "plan": { "color": "#bb9dbd" },
  },
  "formatter": {
    "herb": {
      "command": ["herb-format", "$FILE"],
      "extensions": [".erb"],
    },
    "rubocop": {
      "disabled": true, // avoids conflict with rubotree
    },
    "rubotree": {
      // sequential rubocop/syntax_tree formatting
      "command": ["rubotree", "$FILE"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"],
    },
    "stylua": {
      "command": ["stylua", "$FILE"],
      "extensions": [".lua"],
    },
  },
  "mcp": {
    "servers": {
      "devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executable-path=/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
          "--no-usage-statistics",
          "--user-data-dir={env:XDG_STATE_HOME}/opencode/brave-profile",
        ],
        "disabled": true,
      },
    },
  },
}
